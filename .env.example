# Totebird environment
#
# Production: set keys in Netlify → Site configuration → Environment variables.
# Local (optional): copy this file to .env.local — never commit .env.local.
#
# App runs in DEMO MODE when DATABASE_URL or Clerk keys are missing (or DEMO_MODE=true).
# Check what is set (values never printed):  npm run prove:env
#
# Leave values empty here. Do not paste real secrets into this file — Netlify
# secrets scanning matches env VALUES against repo + build output, so example
# placeholders that equal a Netlify secret will fail the deploy.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated founder emails and/or Clerk user IDs for /admin
ADMIN_EMAIL=
# ADMIN_USER_IDS=

# --- Neon Postgres ---
# If DATABASE_URL is already set on Netlify — leave it alone there.
# Hosted app does NOT run db:push on deploy. Schema apply is local-only later:
#   put the same URL in .env.local → npm run db:push → optional npm run prove:db
# Prefer pooled connection string (sslmode=require).
# Optional CLI: neon login && neon env pull  (project shiny-rice-23336236)
# See neon.ts (Postgres only — app uses Clerk + B2, not Neon Auth/Storage)
DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# --- Clerk (Hobby) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app
# Optional: sync users via webhook
# CLERK_WEBHOOK_SECRET=

# --- Backblaze B2 (shared bucket, S3-compatible presigned uploads) ---
# One bucket for all users. Keys: users/{userId}/links/{linkId}/...
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=totebird-uploads
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# Usually the region segment from the endpoint (optional; derived if omitted)
# B2_REGION=us-west-004
# Optional CDN base for later Cloudflare Worker at files.totebird.com
# NEXT_PUBLIC_FILES_BASE_URL=https://files.totebird.com
# Max upload size in bytes (default 10 MB)
# B2_MAX_UPLOAD_BYTES=10485760

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Totebird <onboarding@resend.dev>

# --- Stripe (invoice Checkout + Billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Billing Price IDs (create Products in Stripe Dashboard)
# Solo $19/mo · $190/yr · Studio $39/mo · $390/yr
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
# Enable Customer Portal in Stripe Dashboard → Settings → Billing → Customer portal

# --- Stripe Connect (Express — freelancer invoice payouts) ---
# Off by default. Enable Connect in Dashboard (Test), then flip the flag.
# STRIPE_CONNECT_ENABLED=true
# Free-tier platform fee in basis points (100 = 1%). Solo/Studio = 0 in code.
# STRIPE_PLATFORM_FEE_BPS=100

# --- Cron / Netlify scheduled reminders ---
# Leave unset for local demo (keeps /api/cron/reminders open for npm run smoke).
# On Netlify production, set a long random string so the daily schedule is locked.
# CRON_SECRET=

# Force demo UI even when keys exist (optional)
# DEMO_MODE=true
